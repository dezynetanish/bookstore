<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body {
            background:
                radial-gradient(circle at top, rgba(145, 98, 54, 0.18), transparent 38%),
                linear-gradient(180deg, #f6ead6 0%, #ebd8b7 35%, #d7b38a 100%);
            color: #2f1f17;
        }

        .medieval-panel {
            background: linear-gradient(135deg, rgba(103, 66, 42, 0.96), rgba(69, 45, 31, 0.96));
            box-shadow: 0 16px 35px rgba(56, 28, 18, 0.18), inset 0 0 0 1px rgba(227, 191, 140, 0.3);
        }

        .parchment {
            background: linear-gradient(180deg, #f9f1e2, #f2e1c0);
            border: 1px solid rgba(123, 85, 53, 0.5);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.3);
        }

        .ornament-border {
            position: relative;
            overflow: hidden;
        }

        .ornament-border::before,
        .ornament-border::after {
            content: "✦";
            position: absolute;
            top: 18px;
            color: rgba(210, 165, 90, 0.9);
            font-size: 1.3rem;
        }

        .ornament-border::before { left: 22px; }
        .ornament-border::after { right: 22px; }
    </style>
</head>

<body class="min-h-screen text-[#2f1f17]">

    <%- include('includes/nav.ejs') %>

    <section class="ornament-border border-b border-[#7d5637]/60 bg-[linear-gradient(135deg,#5c3421,#3f2418_45%,#7d5637)] px-5 py-16 text-center text-[#f8eedc] shadow-[inset_0_0_0_1px_rgba(240,203,147,0.2)]">
        <p class="text-sm uppercase tracking-[6px] text-[#f0c980]">The Book Store</p>
        <h1 class="mt-4 text-4xl font-bold font-serif tracking-wide sm:text-5xl">
            Let us converse on <span class="italic text-[#f4dca8]">poetry and prose.</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm text-[#f2e6d0]/80 sm:text-base">
            A library of thought, memory, and wonder — crafted for readers who love the beauty of every page.
        </p>
    </section>

    <main class="mx-auto grid max-w-6xl gap-8 px-5 py-14 lg:grid-cols-5">

       

        <div class="parchment rounded-[28px] p-6 shadow-[0_18px_32px_rgba(76,48,25,0.12)] sm:p-9 lg:col-span-3">
            <h2 class="text-3xl font-bold font-serif tracking-wide text-[#412a1f]">Send a Message</h2>
            <p class="mt-2 text-sm text-[#664b3a]">
                Share your thoughts and we will answer with care.
            </p>

            <form action="/contact" method="post" class="mt-7 space-y-5">

                <div class="grid gap-5 sm:grid-cols-2">
                    <input type="text" name="name" placeholder="Your Name" required
                        class="rounded-xl border border-[#b98d63] bg-[#fdf8f1] px-4 py-3 text-[#2f1f17] placeholder:text-[#8d6d52] outline-none transition focus:border-[#7c4a2a] focus:ring-2 focus:ring-[#d7b07f]">

                    <input type="tel" name="mobile" placeholder="Phone Number" required
                        class="rounded-xl border border-[#b98d63] bg-[#fdf8f1] px-4 py-3 text-[#2f1f17] placeholder:text-[#8d6d52] outline-none transition focus:border-[#7c4a2a] focus:ring-2 focus:ring-[#d7b07f]">
                </div>

                <input type="email" name="email" placeholder="Email Address" required
                    class="w-full rounded-xl border border-[#b98d63] bg-[#fdf8f1] px-4 py-3 text-[#2f1f17] placeholder:text-[#8d6d52] outline-none transition focus:border-[#7c4a2a] focus:ring-2 focus:ring-[#d7b07f]">

                <textarea name="message" rows="5" placeholder="Write your message..." required
                    class="w-full resize-none rounded-xl border border-[#b98d63] bg-[#fdf8f1] px-4 py-3 text-[#2f1f17] placeholder:text-[#8d6d52] outline-none transition focus:border-[#7c4a2a] focus:ring-2 focus:ring-[#d7b07f]"></textarea>

                <button type="submit"
                    class="w-full rounded-xl bg-[linear-gradient(135deg,#6d4329,#4a2e1d)] px-6 py-3.5 font-semibold text-[#f8eedc] shadow-[0_8px_18px_rgba(74,46,29,0.28)] transition hover:brightness-110">
                    Send Your Message →
                </button>

            </form>
        </div>

    </main>
    <footer class="bg-[linear-gradient(180deg,#3a2418,#1f120d)] py-5 text-center text-sm tracking-[0.18em] text-[#e5d7bf]/70">
        Read. Learn. Grow. © The Book Store
    </footer>

</body>
</html>